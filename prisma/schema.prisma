generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


model Transaction  {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  supplierId      String
  cellPhone       String
  value           Int
  transactionalID String
  createdAt       DateTime @default(now())
}
